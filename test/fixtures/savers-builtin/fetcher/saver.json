    ]
  },
  "downloads": [
    { "file": "page.html", "url": "https://example.com/pinned/page.html", "sha256": "f50fb4b670e0822f5ffe17785a6445ea35446a4a5ef80d981afa8369f6c9cc63" }
  ]
}
