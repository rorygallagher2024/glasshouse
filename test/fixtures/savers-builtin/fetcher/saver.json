{
  "manifest": 1,
  "version": "1.0.0",
  "name": "Fetcher",
  "description": "One of Glasshouse's own that fetches its page, to test with.",
  "license": "MIT",
  "main": "index.html",
  "uses": ["choice"],
  "choices": {
    "default": "one",
    "options": [
      { "id": "one", "name": "One", "value": "vis=one" },
